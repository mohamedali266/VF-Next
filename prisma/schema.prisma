generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  EMPLOYEE
  TEAM_LEADER
  MANAGER
  ADMIN
}

enum Shift {
  AM
  PM
  BW
}

enum AtHomeType {
  FOUR_G
  FIVE_G
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String
  role        Role     @default(EMPLOYEE)
  department  String?
  branchId    String?
  avatarUrl   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  healthChecks HealthCheck[] @relation("EmployeeChecks")
  dailyReports DailyReport[] @relation("EmployeeDailyReports")
  editLogs     EditLog[]     @relation("EditorLogs")
  sessions     Session[]
  accounts     Account[]

  @@map("users")
}

model Branch {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  dailyReports DailyReport[]

  @@map("branches")
}

model HealthCheck {
  id         String   @id @default(cuid())
  employeeId String
  shift      Shift
  date       DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  
  line1Nid   Int      @default(0)
  line2Nid   Int      @default(0)
  line3Nid   Int      @default(0)
  line4Nid   Int      @default(0)
  line5Nid   Int      @default(0)
  line6Nid   Int      @default(0)
  line7Nid   Int      @default(0)
  line8Nid   Int      @default(0)
  line9Nid   Int      @default(0)
  line10Nid  Int      @default(0)

  isLocked    Boolean  @default(true)
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee User @relation("EmployeeChecks", fields: [employeeId], references: [id])
  editLogs EditLog[]

  @@unique([employeeId, date, shift])
  @@map("health_checks")
}

model DailyReport {
  id        String   @id @default(cuid())
  employeeId String
  branchId   String?
  date      DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  storeName String

  pre              Int        @default(0)
  f52              Int        @default(0)
  f80              Int        @default(0)
  aboveF115        Int        @default(0)
  newVmt           Int        @default(0)
  exitVmt          Int        @default(0)
  newRed           Int        @default(0)
  conRed           Int        @default(0)
  mnp              Int        @default(0)
  atHomeType       AtHomeType @default(FOUR_G)
  atHomeCount      Int        @default(0)
  atHomeAch        Int        @default(0)
  adslAch          Int        @default(0)
  terminalAch      Int        @default(0)
  enterpriseNewAcc Int        @default(0)
  enterpriseGas    Int        @default(0)
  totalDailyAch    Int        @default(0)

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee User    @relation("EmployeeDailyReports", fields: [employeeId], references: [id], onDelete: Cascade)
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([employeeId, date])
  @@index([date])
  @@index([branchId, date])
  @@map("daily_reports")
}

model EditLog {
  id            String      @id @default(cuid())
  healthCheckId String
  editedById    String
  oldValues     Json
  newValues     Json
  reason        String
  editedAt      DateTime    @default(now())

  healthCheck HealthCheck @relation(fields: [healthCheckId], references: [id])
  editedBy    User        @relation("EditorLogs", fields: [editedById], references: [id])

  @@map("edit_logs")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
