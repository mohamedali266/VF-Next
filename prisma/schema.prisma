generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  EMPLOYEE
  TEAM_LEADER
  MANAGER
  AREA_MANAGER
  ADMIN
}

enum Shift {
  AM
  PM
  BW
}

enum AtHomeType {
  FOUR_G
  FIVE_G
}

enum ScheduleStatus {
  DRAFT
  SUBMITTED
}

enum ScheduleApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ScheduleShift {
  AM
  PM
  FULL
  OFF
  ANN
  BW
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  username    String?  @unique
  vpnNum      String?  @unique
  staffId     String?  @unique
  password    String
  role        Role     @default(EMPLOYEE)
  department  String?
  branchId    String?
  areaId      String?
  avatarUrl        String?
  telegramChatId   String?  @unique
  telegramLinkCode String?
  isMaster         Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  area         Area?         @relation("AreaUsers", fields: [areaId], references: [id], onDelete: SetNull)
  healthChecks HealthCheck[] @relation("EmployeeChecks")
  dailyReports DailyReport[] @relation("EmployeeDailyReports")
  editLogs     EditLog[]     @relation("EditorLogs")
  cstCustomers CstCustomer[] @relation("AgentCstCustomers")
  scheduleEntries ShiftScheduleEntry[] @relation("ScheduleEmployeeEntries")
  createdSchedules ShiftSchedule[] @relation("ScheduleCreatedBy")
  updatedSchedules ShiftSchedule[] @relation("ScheduleUpdatedBy")
  submittedSchedules ShiftSchedule[] @relation("ScheduleSubmittedBy")
  reviewedSchedules ShiftSchedule[] @relation("ScheduleReviewedBy")
  sessions     Session[]
  accounts     Account[]

  @@map("users")
}

model Area {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches Branch[]
  users    User[]   @relation("AreaUsers")

  @@map("areas")
}

model Branch {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String?  @unique
  terminalCount Int  @default(2)
  areaId    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  area         Area? @relation(fields: [areaId], references: [id], onDelete: SetNull)
  users        User[]
  dailyReports DailyReport[]
  shiftSchedules ShiftSchedule[]

  @@map("branches")
}

model ShiftSchedule {
  id            String         @id @default(cuid())
  branchId      String
  month         DateTime       @db.Date
  status        ScheduleStatus @default(DRAFT)
  submittedAt   DateTime?
  submittedById String?
  createdById   String
  updatedById   String?
  approvalStatus ScheduleApprovalStatus @default(PENDING)
  reviewedAt     DateTime?
  reviewedById   String?
  reviewComment  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  branch      Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdBy   User   @relation("ScheduleCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?  @relation("ScheduleUpdatedBy", fields: [updatedById], references: [id])
  submittedBy User?  @relation("ScheduleSubmittedBy", fields: [submittedById], references: [id])
  reviewedBy  User?  @relation("ScheduleReviewedBy", fields: [reviewedById], references: [id])
  entries     ShiftScheduleEntry[]

  @@unique([branchId, month])
  @@index([month])
  @@map("shift_schedules")
}

model ShiftScheduleEntry {
  id         String        @id @default(cuid())
  scheduleId String
  employeeId String
  date       DateTime      @db.Date
  shift      ScheduleShift
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  schedule ShiftSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  employee User          @relation("ScheduleEmployeeEntries", fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, employeeId, date])
  @@index([employeeId, date])
  @@map("shift_schedule_entries")
}

model HealthCheck {
  id         String   @id @default(cuid())
  employeeId String
  shift      Shift
  date       DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  
  line1Nid   Int      @default(0)
  line2Nid   Int      @default(0)
  line3Nid   Int      @default(0)
  line4Nid   Int      @default(0)
  line5Nid   Int      @default(0)
  line6Nid   Int      @default(0)
  line7Nid   Int      @default(0)
  line8Nid   Int      @default(0)
  line9Nid   Int      @default(0)
  line10Nid  Int      @default(0)

  isLocked    Boolean  @default(true)
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee User @relation("EmployeeChecks", fields: [employeeId], references: [id])
  editLogs EditLog[]

  @@unique([employeeId, date, shift])
  @@map("health_checks")
}

model DailyReport {
  id        String   @id @default(cuid())
  employeeId String
  branchId   String?
  date      DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  storeName String

  pre              Int        @default(0)
  f52              Int        @default(0)
  f80              Int        @default(0)
  aboveF115        Int        @default(0)
  newVmt           Int        @default(0)
  exitVmt          Int        @default(0)
  newRed           Int        @default(0)
  conRed           Int        @default(0)
  mnp              Int        @default(0)
  atHomeType       AtHomeType @default(FOUR_G)
  atHomeCount      Int        @default(0)
  atHomeAch        Int        @default(0)
  adslAch          Int        @default(0)
  terminalAch      Int        @default(0)
  enterpriseNewAcc Int        @default(0)
  enterpriseGas    Int        @default(0)
  totalDailyAch    Int        @default(0)

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee User    @relation("EmployeeDailyReports", fields: [employeeId], references: [id], onDelete: Cascade)
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([employeeId, date])
  @@index([date])
  @@index([branchId, date])
  @@map("daily_reports")
}

model EditLog {
  id            String      @id @default(cuid())
  healthCheckId String
  editedById    String
  oldValues     Json
  newValues     Json
  reason        String
  editedAt      DateTime    @default(now())

  healthCheck HealthCheck @relation(fields: [healthCheckId], references: [id])
  editedBy    User        @relation("EditorLogs", fields: [editedById], references: [id])

  @@map("edit_logs")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model CstCustomer {
  id          String   @id @default(cuid())
  agentId     String
  name        String
  phone       String
  serviceType String
  status      String    @default("Pending")
  notes       String?
  followUpDate DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime @updatedAt

  agent User @relation("AgentCstCustomers", fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@map("cst_customers")
}
